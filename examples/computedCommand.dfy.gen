// Generated by lsc from computedCommand.ts

datatype Payloads = Payloads(capture: int, refund: int)

datatype Command = capture(amount: int) | refund(amount: int)

datatype Ledger = Ledger(captured: int, refunded: int)

function delta(c: Command): int
{
  match c {
    case capture(i_c_amount) =>
      i_c_amount
    case refund(i_c_amount) =>
      (-(i_c_amount))
  }
}

lemma delta_ensures(c: Command)
  ensures (c.refund? ==> (delta(c) == (-(c.amount))))
  ensures (c.capture? ==> (delta(c) == c.amount))
{
}

function remaining(x: Ledger): int
{
  (x.captured - x.refunded)
}

lemma remaining_ensures(x: Ledger)
  ensures (remaining(x) == (x.captured - x.refunded))
{
}

function readBalance(x: Ledger): int
{
  x.captured
}

lemma readBalance_ensures(x: Ledger)
  ensures (readBalance(x) == x.captured)
{
}

function captureOf(ledger: Ledger): int
{
  readBalance(ledger)
}

lemma captureOf_ensures(ledger: Ledger)
  ensures (captureOf(ledger) == ledger.captured)
{
}
