// Generated by lsc from scaledAmount.ts

function FloorReal(x: real): int
{
  x.Floor
}

function adjusted(intAmount: int, ratio: real): int
{
  FloorReal(((intAmount as real) * ((1 as real) + ratio)))
}

lemma adjusted_ensures(intAmount: int, ratio: real)
  ensures ((intAmount == 10) ==> (ratio == 0.25) ==> (adjusted(intAmount, ratio) == 12))
  ensures ((intAmount == -10) ==> (ratio == 0.25) ==> (adjusted(intAmount, ratio) == -13))
